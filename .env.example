# ── Supabase (PostgREST + pgvector) ───────────────────────────────────────────
# The app talks to Supabase via the PostgREST client using the anon key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# ── OpenAI (LLM + Embeddings — single key for both) ──────────────────────────
OPENAI_API_KEY=
LLM_CHOICE=
INGESTION_LLM_CHOICE=
EMBEDDING_MODEL=
APP_ENV=development
LOG_LEVEL=INFO
APP_PORT=8058

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_PRIVATE_BUCKET=
S3_PUBLIC_BUCKET=

# Access Control Configuration
# Users who can access PRIVATE documents (comma-separated)
PRIVATE_DOCUMENT_USERS=

# Admin users (comma-separated) - can access all documents
ADMIN_USERS=

# JWT Configuration
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Celery + Redis (async task queue) ─────────────────────────────────────────
# Use the docker service hostname for compose; localhost for a bare local run.
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
# Optional independent overrides (default to REDIS_URL):
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TIMEZONE=UTC
# Periodic S3 ingest sweep interval (minutes) and on/off switch for Beat.
INGEST_INTERVAL_MINUTES=15
AUTO_INGEST_ENABLED=true

# ── Session memory ────────────────────────────────────────────────────────────
# redis = history shared across all api/worker processes (recommended);
# memory = per-process in-memory (fine for a single process / local dev).
SESSION_MEMORY_BACKEND=redis
SESSION_TTL_SECONDS=86400           # rolling per-session expiry (24h); not permanent
CONTEXT_WINDOW_TURNS=10             # sliding window: last N user+assistant turns
SESSION_KEY_PREFIX=uchenab:session:

# ── App networking (consumed by docker-compose) ───────────────────────────────
APP_HOST=0.0.0.0
# APP_PORT is defined above; REDIS_PORT exposes Redis on the host.

# CORS allow-list (comma-separated origins). Never "*". Add your deployed
# frontend origin(s); defaults cover the local Vite/React dev servers.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Vespa (primary retrieval: BM25 + dense + RRF) ─────────────────────────────
# Endpoint of the Vespa query/feed container. Use the compose service name in
# Docker (http://vespa:8080) or http://localhost:8080 for a bare local run.
VESPA_ENDPOINT=http://localhost:8080
VESPA_ENABLED=true                  # false -> retrieval falls back to Postgres
VESPA_NAMESPACE=chunks
VESPA_TIMEOUT=10
# Host port mappings consumed by docker-compose:
VESPA_QUERY_PORT=8080
VESPA_CONFIG_PORT=19071

# ── Reranker (stage 2: cross-encoder precision rerank) ───────────────────────
# Fail-open: with no key (or RERANK_ENABLED=false) the pipeline skips reranking
# and uses the retriever's fused order — retrieval never breaks.
RERANK_ENABLED=true
RERANK_PROVIDER=voyage              # only "voyage" implemented today
RERANK_MODEL=rerank-2-lite
RERANK_CANDIDATES=50                # candidate pool pulled before reranking to limit
RERANK_TIMEOUT=10
VOYAGE_API_KEY=                     # absent -> reranker no-ops gracefully

# ── Anti-hallucination ───────────────────────────────────────────────────────
# Min top pgvector cosine for an answer to be considered grounded; below this
# the agent abstains (and, on the web path, alerts an admin).
CONFIDENCE_MIN_SIMILARITY=0.25

# Tier 4 — semantic groundedness judge. After citation enforcement passes, an
# LLM checks that the cited chunks actually ENTAIL the answer's claims; if not,
# the agent abstains. This is the strongest anti-hallucination layer and the
# main added per-turn cost (one short LLM call on answered turns). Fail-open.
GROUNDEDNESS_CHECK_ENABLED=true
# GROUNDEDNESS_MODEL=               # defaults to LLM_CHOICE
GROUNDEDNESS_MIN_WORDS=12           # skip greetings/short acknowledgements
GROUNDEDNESS_MAX_CHUNKS=8           # evidence chunks shown to the judge
# Claim-level remediation: when an answer is ungrounded, strip ONLY the
# unsupported claims and keep the grounded (still-cited) remainder instead of
# abstaining on the whole answer. Abstains only when nothing survives.
GROUNDEDNESS_REMEDIATION_ENABLED=true
# Re-judge the remediated answer before trusting it (extra LLM call; off by
# default — the editor already keeps only supported claims).
GROUNDEDNESS_REVERIFY=false

# ── Turn-level answer cache (primary cost lever) ─────────────────────────────
# Memoizes the WHOLE turn outcome (final answer + tools) keyed by the canonical
# history-resolved query, so repeat/near-duplicate questions skip scope + agent
# + retrieval + groundedness entirely (zero model calls). Only verified-good
# answers are cached (never abstentions/escalations); admin requests bypass it;
# shares the retrieval cache's ingest-invalidation. Fail-open.
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_TTL=600                # per-entry TTL seconds (10 min)
ANSWER_CACHE_PREFIX=uchenab:answercache:

# ── Conversational query rewriting (multi-turn recall) ───────────────────────
# Condenses follow-ups ("and the fee?") into a self-contained query using the
# session history BEFORE retrieval, so the embedding captures full intent.
# Only fires when history exists; fail-open to the original query.
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_MAXLEN=400            # skip rewrite for long, already-complete asks

# ── Retrieval cache (cost lever) ─────────────────────────────────────────────
# Memoizes the post-rerank chunk list in Redis, keyed by normalized query +
# access scope + limit, so repeat/near-duplicate questions skip embed+Vespa+
# rerank entirely. Auto-invalidated on every successful ingest. Fail-open.
RAG_QUERY_CACHE_ENABLED=true
RAG_CACHE_TTL=300                   # per-entry TTL seconds (5 min)
RAG_CACHE_PREFIX=uchenab:ragcache:

# ── Guardrails ────────────────────────────────────────────────────────────────
GUARDRAILS_ENABLED=true
ENFORCE_ROMAN_URDU=false         # optional: transliterate Devanagari output (disabled by default)
GUARDRAIL_MAX_INPUT_CHARS=4000
GUARDRAIL_MIN_INPUT_CHARS=1
